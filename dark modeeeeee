<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <style>

    * {
      box-sizing: border-box;
    }

    :root {

      --page-bg: #f5f6f8;
      --card-bg: #ffffff;
      --input-bg: #ffffff;

      --text-primary: #202124;
      --text-secondary: #5f6368;

      --border: #dadce0;

      --response-bg: #f8f9fa;

      --button-bg: #1a73e8;
      --button-hover: #1557b0;

      --header-bg: #000000;
      --header-input: #121212;

      --clear-hover: #e8eaed;

      --message-bg: #202124;
      --message-text: #ffffff;

      --shadow:
        0 3px 10px rgba(0, 0, 0, 0.08);

      --transition: 0.2s ease;

    }


    /* =====================================
       DARK MODE VARIABLES
    ===================================== */

    body.dark {

      --page-bg: #0f0f0f;
      --card-bg: #181818;
      --input-bg: #121212;

      --text-primary: #f1f1f1;
      --text-secondary: #aaaaaa;

      --border: #303030;

      --response-bg: #222222;

      --button-bg: #272727;
      --button-hover: #3a3a3a;

      --header-bg: #000000;
      --header-input: #121212;

      --clear-hover: #303030;

      --message-bg: #f1f1f1;
      --message-text: #0f0f0f;

      --shadow:
        0 4px 15px rgba(0, 0, 0, 0.35);

    }


    /* =====================================
       BODY
    ===================================== */

    body {

      margin: 0;

      font-family:
        Arial,
        sans-serif;

      background:
        var(--page-bg);

      color:
        var(--text-primary);

      transition:
        background var(--transition),
        color var(--transition);

    }


    /* =====================================
       HEADER
    ===================================== */

    .header {

      width: 100%;

      background:
        var(--header-bg);

      color: white;

    }


    .header-inner {

      max-width: 1280px;

      height: 70px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1fr 2fr 1fr;

      align-items: center;

      padding: 0 24px;

      gap: 25px;

    }


    /* =====================================
       BRAND / HOME
    ===================================== */

    .brand {

      display: flex;

      align-items: center;

      gap: 10px;

      white-space: nowrap;

      cursor: pointer;

      user-select: none;

    }


    .youtube-icon {

      width: 34px;

      height: 24px;

      background: #ff0000;

      border-radius: 7px;

      display: flex;

      align-items: center;

      justify-content: center;

      flex-shrink: 0;

    }


    .youtube-icon::after {

      content: "";

      width: 0;

      height: 0;

      border-top:
        6px solid transparent;

      border-bottom:
        6px solid transparent;

      border-left:
        9px solid white;

      margin-left: 2px;

    }


    .brand-title {

      font-size: 18px;

      font-weight: 600;

    }


    .brand:hover {

      opacity: 0.85;

    }


    /* =====================================
       SEARCH
    ===================================== */

    .header-search {

      width: 100%;

      max-width: 600px;

      margin: 0 auto;

      display: flex;

      align-items: center;

    }


    .search-wrapper {

      position: relative;

      width: 100%;

    }


    .header-search input {

      width: 100%;

      height: 40px;

      background:
        var(--header-input);

      color: white;

      border:
        1px solid #303030;

      border-radius: 20px;

      padding:
        0 42px 0 18px;

      font-size: 15px;

      outline: none;

      transition:
        border var(--transition);

    }


    .header-search input::placeholder {

      color: #aaaaaa;

    }


    .header-search input:focus {

      border-color: #555555;

    }


    /* =====================================
       CLEAR BUTTONS
    ===================================== */

    .clear-button {

      position: absolute;

      right: 10px;

      top: 50%;

      transform:
        translateY(-50%);

      width: 24px;

      height: 24px;

      border: none;

      border-radius: 50%;

      background: transparent;

      color: #aaaaaa;

      font-size: 19px;

      line-height: 20px;

      cursor: pointer;

      display: none;

      align-items: center;

      justify-content: center;

      padding: 0;

    }


    .clear-button:hover {

      background:
        var(--clear-hover);

      color:
        var(--text-primary);

    }


    /* =====================================
       AGENT NAME
    ===================================== */

    .agent-area {

      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 8px;

      white-space: nowrap;

    }


    .agent-label {

      font-size: 13px;

      color: #aaaaaa;

    }


    .agent-wrapper {

      position: relative;

      width: 130px;

    }


    .agent-input {

      width: 100%;

      height: 36px;

      background:
        var(--header-input);

      color: white;

      border:
        1px solid #303030;

      border-radius: 18px;

      padding:
        0 35px 0 14px;

      font-size: 14px;

      outline: none;

    }


    .agent-input::placeholder {

      color: #888888;

    }


    .agent-input:focus {

      border-color:
        #555555;

    }


    /* =====================================
       THEME SWITCH
    ===================================== */

    .theme-toggle {

      width: 42px;

      height: 42px;

      border: none;

      border-radius: 50%;

      background: #181818;

      color: white;

      cursor: pointer;

      font-size: 19px;

      display: flex;

      align-items: center;

      justify-content: center;

      transition:
        background var(--transition),
        transform var(--transition);

      margin-left: 4px;

    }


    .theme-toggle:hover {

      background: #303030;

      transform:
        scale(1.08);

    }


    /* =====================================
       MAIN CONTENT
    ===================================== */

    .container {

      max-width: 950px;

      margin: 0 auto;

      padding:
        30px 25px 60px;

    }


    /* =====================================
       CUSTOMER NAME
    ===================================== */

    .customer-section {

      background:
        var(--card-bg);

      padding:
        18px 20px;

      border-radius: 12px;

      border:
        1px solid var(--border);

      margin-bottom: 25px;

      transition:
        background var(--transition),
        border var(--transition);

    }


    .customer-label {

      display: block;

      font-size: 14px;

      font-weight: bold;

      margin-bottom: 7px;

    }


    .customer-wrapper {

      position: relative;

      width: 100%;

    }


    .customer-input {

      width: 100%;

      padding:
        12px 42px 12px 14px;

      font-size: 16px;

      background:
        var(--input-bg);

      color:
        var(--text-primary);

      border:
        1px solid var(--border);

      border-radius: 8px;

      outline: none;

      transition:
        background var(--transition),
        color var(--transition),
        border var(--transition);

    }


    .customer-input::placeholder {

      color:
        var(--text-secondary);

    }


    .customer-input:focus {

      border-color:
        #1a73e8;

    }


    .customer-wrapper
    .clear-button {

      right: 10px;

      color:
        var(--text-secondary);

    }


    /* =====================================
       L1 + L2 BUTTONS
    ===================================== */

    .categories,
    .subcategories {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;

    }


    .category-button,
    .subcategory-button {

      width: 100%;

      padding: 20px;

      font-size: 18px;

      font-weight: bold;

      border: none;

      border-radius: 12px;

      background:
        var(--button-bg);

      color:
        var(--text-primary);

      cursor: pointer;

      transition:
        background var(--transition),
        transform var(--transition),
        box-shadow var(--transition);

    }


    .category-button:hover,
    .subcategory-button:hover {

      background:
        var(--button-hover);

      transform:
        translateY(-2px);

      box-shadow:
        var(--shadow);

    }


    /* =====================================
       NAVIGATION HEADER
    ===================================== */

    .navigation-header {

      display: flex;

      justify-content:
        space-between;

      align-items: center;

      margin-bottom: 18px;

    }


    .navigation-title {

      font-size: 22px;

      font-weight: bold;

    }


    .back-button {

      border: none;

      background: transparent;

      color: #3ea6ff;

      font-size: 15px;

      cursor: pointer;

      font-weight: bold;

    }


    .back-button:hover {

      text-decoration:
        underline;

    }


    /* =====================================
       RESPONSE AREA
    ===================================== */

    .response-area {

      margin-top: 30px;

    }


    /* =====================================
       RESPONSE CARDS
    ===================================== */

    .response-card {

      background:
        var(--card-bg);

      border:
        1px solid var(--border);

      border-radius: 12px;

      padding: 20px;

      margin-bottom: 18px;

      cursor: pointer;

      transition:
        background var(--transition),
        border var(--transition),
        box-shadow var(--transition),
        transform var(--transition);

    }


    .response-card:hover {

      border-color:
        #3ea6ff;

      box-shadow:
        var(--shadow);

      transform:
        translateY(-1px);

    }


    .description {

      font-size: 16px;

      font-weight: bold;

      margin-bottom: 15px;

    }


    .response {

      padding: 15px;

      background:
        var(--response-bg);

      border-radius: 8px;

      line-height: 1.55;

      font-size: 15px;

      white-space: pre-wrap;

      color:
        var(--text-primary);

    }


    .copy-hint {

      margin-top: 12px;

      font-size: 13px;

      color:
        var(--text-secondary);

      text-align: right;

    }


    /* =====================================
       SEARCH RESULTS
    ===================================== */

    .search-heading {

      font-size: 20px;

      font-weight: bold;

      margin-bottom: 18px;

    }


    .search-category {

      font-size: 12px;

      color:
        #3ea6ff;

      font-weight: bold;

      margin-bottom: 5px;

      text-transform:
        uppercase;

    }


    .search-situation {

      font-size: 14px;

      color:
        var(--text-secondary);

      font-weight: bold;

      margin-bottom: 12px;

    }


    .no-results {

      background:
        var(--card-bg);

      border:
        1px solid var(--border);

      border-radius: 10px;

      padding: 20px;

      text-align: center;

      color:
        var(--text-secondary);

    }


    /* =====================================
       COPY MESSAGE
    ===================================== */

    .message {

      position: fixed;

      bottom: 25px;

      left: 50%;

      transform:
        translateX(-50%);

      background:
        var(--message-bg);

      color:
        var(--message-text);

      padding:
        14px 22px;

      border-radius: 8px;

      display: none;

      font-size: 15px;

      z-index: 1000;

      box-shadow:
        var(--shadow);

    }


    /* =====================================
       FOOTER
    ===================================== */

    .footer {

      margin-top: 50px;

      padding: 15px 0;

      text-align: center;

      font-size: 11px;

      color:
        var(--text-secondary);

      letter-spacing: 0.2px;

    }


    /* =====================================
       MOBILE
    ===================================== */

    @media (max-width: 800px) {

      .header-inner {

        grid-template-columns:
          1fr;

        height: auto;

        padding:
          15px 20px;

        gap: 12px;

      }


      .brand {

        justify-content:
          center;

      }


      .header-search {

        max-width: 100%;

      }


      .agent-area {

        justify-content:
          center;

      }


      .categories,
      .subcategories {

        grid-template-columns:
          1fr;

      }

    }

  </style>

</head>


<body>


  <!-- =====================================
       HEADER
  ===================================== -->

  <header class="header">

    <div class="header-inner">


      <!-- HOME / BRAND -->

      <div
        class="brand"
        onclick="goHome()"
        title="Home"
      >

        <div class="youtube-icon"></div>

        <div class="brand-title">
          Canned Response Tool
        </div>

      </div>


      <!-- SEARCH -->

      <div class="header-search">

        <div class="search-wrapper">

          <input
            id="searchInput"
            type="text"
            placeholder="Search canned responses..."
            oninput="performSearch()"
          >

          <button
            id="searchClear"
            class="clear-button"
            onclick="clearSearch()"
            title="Clear search"
          >
            ×
          </button>

        </div>

      </div>


      <!-- AGENT NAME -->

      <div class="agent-area">

        <span class="agent-label">
          Agent:
        </span>

        <div class="agent-wrapper">

          <input
            id="agentName"
            class="agent-input"
            type="text"
            placeholder="Your name"
            oninput="updateAgentClearButton()"
          >

          <button
            id="agentClear"
            class="clear-button"
            onclick="clearAgentName()"
            title="Clear name"
          >
            ×
          </button>

        </div>


        <!-- DARK MODE -->

        <button
          id="themeToggle"
          class="theme-toggle"
          onclick="toggleTheme()"
          title="Switch theme"
        >
          ☀
        </button>

      </div>

    </div>

  </header>



  <!-- =====================================
       MAIN
  ===================================== -->

  <div class="container">


    <!-- CUSTOMER NAME -->

    <div class="customer-section">

      <label class="customer-label">
        Customer Name
      </label>

      <div class="customer-wrapper">

        <input
          id="customerName"
          class="customer-input"
          type="text"
          placeholder="Enter customer name"
          oninput="updateCustomerClearButton()"
        >

        <button
          id="customerClear"
          class="clear-button"
          onclick="clearCustomerName()"
          title="Clear customer name"
        >
          ×
        </button>

      </div>

    </div>



    <!-- =====================================
         L1 CATEGORIES
    ===================================== -->

    <div
      id="categories"
      class="categories"
    >

      Loading categories...

    </div>



    <!-- =====================================
         L2 SUBCATEGORIES
    ===================================== -->

    <div
      id="subcategoryArea"
      style="display: none;"
    >

      <div class="navigation-header">

        <div
          id="subcategoryTitle"
          class="navigation-title"
        >
        </div>

        <button
          class="back-button"
          onclick="goBackToCategories()"
        >
          ← Back
        </button>

      </div>


      <div
        id="subcategories"
        class="subcategories"
      >
      </div>

    </div>



    <!-- =====================================
         CANNED RESPONSES
    ===================================== -->

    <div
      id="responseArea"
      class="response-area"
      style="display: none;"
    >

      <div class="navigation-header">

        <div
          id="responseTitle"
          class="navigation-title"
        >
        </div>

        <button
          class="back-button"
          onclick="goBackToSubcategories()"
        >
          ← Back
        </button>

      </div>


      <div id="responses"></div>

    </div>



    <!-- =====================================
         SEARCH RESULTS
    ===================================== -->

    <div
      id="searchResults"
      class="response-area"
      style="display: none;"
    >

      <div class="search-heading">
        Search Results
      </div>

      <div
        id="searchResultsContainer"
      >
      </div>

    </div>



    <!-- FOOTER -->

    <footer class="footer">

      Internal Support Utility ·
      Build 1.0.0 ·
      2026 ·
      Developed by Mohit Sihag ·
      Quality Team ·
      TP GGN IND

    </footer>

  </div>



  <!-- COPY MESSAGE -->

  <div
    id="message"
    class="message"
  >
    ✓ Response copied to clipboard
  </div>



  <script>

    let allResponses = [];

    let currentCategory = "";

    let currentSituation = "";


    /* =====================================
       LOAD DATA
    ===================================== */

    google.script.run

      .withSuccessHandler(function(data) {

        allResponses = data;

        buildCategoryButtons();

      })

      .withFailureHandler(function(error) {

        console.error(error);

        document.getElementById(
          "categories"
        ).innerHTML =
          "<p>Could not load responses.</p>";

        alert(
          "ERROR: " +
          error.message
        );

      })

      .getResponses();



    /* =====================================
       THEME INITIALIZATION
    ===================================== */

    function initializeTheme() {

      const savedTheme =
        localStorage.getItem(
          "cannedResponseTheme"
        );


      /*
       * Dark mode is default.
       */

      if (
        savedTheme === "light"
      ) {

        document.body.classList.remove(
          "dark"
        );

      } else {

        document.body.classList.add(
          "dark"
        );

      }


      updateThemeButton();

    }



    /* =====================================
       TOGGLE THEME
    ===================================== */

    function toggleTheme() {

      document.body.classList.toggle(
        "dark"
      );


      const isDark =
        document.body.classList.contains(
          "dark"
        );


      localStorage.setItem(
        "cannedResponseTheme",
        isDark
          ? "dark"
          : "light"
      );


      updateThemeButton();

    }



    /* =====================================
       THEME BUTTON ICON
    ===================================== */

    function updateThemeButton() {

      const button =
        document.getElementById(
          "themeToggle"
        );


      const isDark =
        document.body.classList.contains(
          "dark"
        );


      if (isDark) {

        /*
         * Currently dark.
         * Show sun = switch to light.
         */

        button.textContent = "☀";

        button.title =
          "Switch to light mode";

      } else {

        /*
         * Currently light.
         * Show moon = switch to dark.
         */

        button.textContent = "☾";

        button.title =
          "Switch to dark mode";

      }

    }



    /*
     * Initialize theme immediately.
     */

    initializeTheme();



    /* =====================================
       BUILD L1 CATEGORY BUTTONS
    ===================================== */

    function buildCategoryButtons() {

      const container =
        document.getElementById(
          "categories"
        );

      container.innerHTML = "";


      const categories = [
        ...new Set(

          allResponses.map(
            function(item) {

              return item.category;

            }
          )

        )
      ];


      categories.forEach(
        function(category) {

          const button =
            document.createElement(
              "button"
            );

          button.className =
            "category-button";

          button.textContent =
            category.toUpperCase();


          button.addEventListener(
            "click",
            function() {

              showSubcategories(
                category
              );

            }
          );


          container.appendChild(
            button
          );

        }
      );

    }



    /* =====================================
       SHOW L2 SUBCATEGORIES
    ===================================== */

    function showSubcategories(
      category
    ) {

      currentCategory =
        category;


      document
        .getElementById(
          "categories"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "responseArea"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "searchResults"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "subcategoryArea"
        )
        .style.display =
          "block";


      document
        .getElementById(
          "subcategoryTitle"
        )
        .textContent =
          category.toUpperCase();


      const container =
        document.getElementById(
          "subcategories"
        );

      container.innerHTML =
        "";


      const categoryResponses =
        allResponses.filter(
          function(item) {

            return item.category ===
              category;

          }
        );


      const situations = [
        ...new Set(

          categoryResponses.map(
            function(item) {

              return item.situation;

            }
          )

        )
      ];


      situations.forEach(
        function(situation) {

          const button =
            document.createElement(
              "button"
            );

          button.className =
            "subcategory-button";

          button.textContent =
            situation;


          button.addEventListener(
            "click",
            function() {

              showResponses(
                category,
                situation
              );

            }
          );


          container.appendChild(
            button
          );

        }
      );

    }



    /* =====================================
       SHOW CANNED RESPONSES
    ===================================== */

    function showResponses(
      category,
      situation
    ) {

      currentCategory =
        category;

      currentSituation =
        situation;


      document
        .getElementById(
          "subcategoryArea"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "responseArea"
        )
        .style.display =
          "block";


      document
        .getElementById(
          "responseTitle"
        )
        .textContent =
          situation;


      const container =
        document.getElementById(
          "responses"
        );

      container.innerHTML =
        "";


      const matchingResponses =
        allResponses.filter(
          function(item) {

            return (
              item.category === category &&
              item.situation === situation
            );

          }
        );


      matchingResponses.forEach(
        function(item) {

          createResponseCard(
            item,
            container
          );

        }
      );

    }



    /* =====================================
       CREATE RESPONSE CARD
    ===================================== */

    function createResponseCard(
      item,
      container
    ) {

      const card =
        document.createElement(
          "div"
        );

      card.className =
        "response-card";


      const description =
        document.createElement(
          "div"
        );

      description.className =
        "description";

      description.textContent =
        item.description;


      const response =
        document.createElement(
          "div"
        );

      response.className =
        "response";


      const personalizedResponse =
        personalizeResponse(
          item.response
        );


      response.textContent =
        personalizedResponse;


      const copyHint =
        document.createElement(
          "div"
        );

      copyHint.className =
        "copy-hint";

      copyHint.textContent =
        "Click anywhere to copy";


      card.appendChild(
        description
      );

      card.appendChild(
        response
      );

      card.appendChild(
        copyHint
      );


      card.addEventListener(
        "click",
        function() {

          copyResponse(
            personalizedResponse
          );

        }
      );


      container.appendChild(
        card
      );

    }



    /* =====================================
       PERSONALIZE RESPONSE
    ===================================== */

    function personalizeResponse(
      response
    ) {

      const customerName =
        document
          .getElementById(
            "customerName"
          )
          .value
          .trim();


      const agentName =
        document
          .getElementById(
            "agentName"
          )
          .value
          .trim();


      return response

        .replace(
          /{{CUSTOMER_NAME}}/g,
          customerName ||
          "there"
        )

        .replace(
          /{{REPRESENTATIVE_NAME}}/g,
          agentName ||
          "your representative"
        );

    }



    /* =====================================
       SEARCH
    ===================================== */

    function performSearch() {

      const searchInput =
        document
          .getElementById(
            "searchInput"
          )
          .value
          .trim()
          .toLowerCase();


      updateSearchClearButton();


      const categories =
        document.getElementById(
          "categories"
        );


      const subcategoryArea =
        document.getElementById(
          "subcategoryArea"
        );


      const responseArea =
        document.getElementById(
          "responseArea"
        );


      const searchResults =
        document.getElementById(
          "searchResults"
        );


      const resultsContainer =
        document.getElementById(
          "searchResultsContainer"
        );


      if (!searchInput) {

        searchResults.style.display =
          "none";

        responseArea.style.display =
          "none";

        subcategoryArea.style.display =
          "none";

        categories.style.display =
          "grid";

        return;

      }


      categories.style.display =
        "none";

      subcategoryArea.style.display =
        "none";

      responseArea.style.display =
        "none";

      searchResults.style.display =
        "block";


      resultsContainer.innerHTML =
        "";


      const results =
        allResponses.filter(
          function(item) {

            const searchableText = [

              item.category,

              item.situation,

              item.description,

              item.response

            ]
              .join(" ")
              .toLowerCase();


            return searchableText.includes(
              searchInput
            );

          }
        );


      if (results.length === 0) {

        resultsContainer.innerHTML = `
          <div class="no-results">
            No matching responses found.
          </div>
        `;

        return;

      }


      results.forEach(
        function(item) {

          const card =
            document.createElement(
              "div"
            );

          card.className =
            "response-card";


          const category =
            document.createElement(
              "div"
            );

          category.className =
            "search-category";

          category.textContent =
            item.category;


          const situation =
            document.createElement(
              "div"
            );

          situation.className =
            "search-situation";

          situation.textContent =
            item.situation;


          const description =
            document.createElement(
              "div"
            );

          description.className =
            "description";

          description.textContent =
            item.description;


          const response =
            document.createElement(
              "div"
            );

          response.className =
            "response";


          const personalizedResponse =
            personalizeResponse(
              item.response
            );


          response.textContent =
            personalizedResponse;


          const copyHint =
            document.createElement(
              "div"
            );

          copyHint.className =
            "copy-hint";

          copyHint.textContent =
            "Click anywhere to copy";


          card.appendChild(
            category
          );

          card.appendChild(
            situation
          );

          card.appendChild(
            description
          );

          card.appendChild(
            response
          );

          card.appendChild(
            copyHint
          );


          card.addEventListener(
            "click",
            function() {

              copyResponse(
                personalizedResponse
              );

            }
          );


          resultsContainer.appendChild(
            card
          );

        }
      );

    }



    /* =====================================
       HOME
    ===================================== */

    function goHome() {

      document
        .getElementById(
          "subcategoryArea"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "responseArea"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "searchResults"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "categories"
        )
        .style.display =
          "grid";


      document
        .getElementById(
          "searchInput"
        )
        .value =
          "";


      updateSearchClearButton();


      currentCategory =
        "";

      currentSituation =
        "";

    }



    /* =====================================
       BACK: L2 → L1
    ===================================== */

    function goBackToCategories() {

      goHome();

    }



    /* =====================================
       BACK: RESPONSES → L2
    ===================================== */

    function goBackToSubcategories() {

      document
        .getElementById(
          "responseArea"
        )
        .style.display =
          "none";


      showSubcategories(
        currentCategory
      );

    }



    /* =====================================
       CLEAR SEARCH
    ===================================== */

    function clearSearch() {

      document
        .getElementById(
          "searchInput"
        )
        .value =
          "";


      updateSearchClearButton();


      goHome();


      document
        .getElementById(
          "searchInput"
        )
        .focus();

    }



    /* =====================================
       SEARCH CLEAR BUTTON
    ===================================== */

    function updateSearchClearButton() {

      const input =
        document.getElementById(
          "searchInput"
        );

      const button =
        document.getElementById(
          "searchClear"
        );


      button.style.display =
        input.value.trim()
          ? "flex"
          : "none";

    }



    /* =====================================
       CLEAR AGENT NAME
    ===================================== */

    function clearAgentName() {

      const input =
        document.getElementById(
          "agentName"
        );


      input.value =
        "";


      updateAgentClearButton();


      input.focus();

    }



    /* =====================================
       AGENT CLEAR BUTTON
    ===================================== */

    function updateAgentClearButton() {

      const input =
        document.getElementById(
          "agentName"
        );

      const button =
        document.getElementById(
          "agentClear"
        );


      button.style.display =
        input.value.trim()
          ? "flex"
          : "none";

    }



    /* =====================================
       CLEAR CUSTOMER NAME
    ===================================== */

    function clearCustomerName() {

      const input =
        document.getElementById(
          "customerName"
        );


      input.value =
        "";


      updateCustomerClearButton();


      input.focus();

    }



    /* =====================================
       CUSTOMER CLEAR BUTTON
    ===================================== */

    function updateCustomerClearButton() {

      const input =
        document.getElementById(
          "customerName"
        );

      const button =
        document.getElementById(
          "customerClear"
        );


      button.style.display =
        input.value.trim()
          ? "flex"
          : "none";

    }



    /* =====================================
       COPY RESPONSE
    ===================================== */

    function copyResponse(
      response
    ) {

      navigator.clipboard
        .writeText(response)

        .then(
          function() {

            showMessage();

          }
        )

        .catch(
          function(error) {

            console.error(error);

            alert(
              "Could not copy response to clipboard."
            );

          }
        );

    }



    /* =====================================
       COPY MESSAGE
    ===================================== */

    function showMessage() {

      const message =
        document.getElementById(
          "message"
        );


      message.style.display =
        "block";


      setTimeout(
        function() {

          message.style.display =
            "none";

        },
        1500
      );

    }



    /* =====================================
       INITIAL CLEAR BUTTON STATE
    ===================================== */

    updateSearchClearButton();

    updateAgentClearButton();

    updateCustomerClearButton();

  </script>

</body>

</html>
