<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f6f8;
      color: #202124;
    }


    /* =====================================
       YOUTUBE-STYLE HEADER
    ===================================== */

    .header {
      width: 100%;
      background: #000000;
      color: white;
    }

    .header-inner {
      max-width: 1280px;
      height: 70px;
      margin: 0 auto;

      display: grid;
      grid-template-columns: 1fr 2fr 1fr;
      align-items: center;

      padding: 0 24px;
      gap: 25px;
    }


    /* =====================================
       LEFT SIDE - LOGO + TITLE
    ===================================== */

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }

    .youtube-icon {
      width: 34px;
      height: 24px;
      background: #ff0000;
      border-radius: 7px;

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .youtube-icon::after {
      content: "";
      width: 0;
      height: 0;

      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-left: 9px solid white;

      margin-left: 2px;
    }

    .brand-title {
      font-size: 18px;
      font-weight: 600;
    }


    /* =====================================
       CENTER - SEARCH
    ===================================== */

    .header-search {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;

      display: flex;
      align-items: center;
    }

    .header-search input {
      width: 100%;
      height: 40px;

      background: #121212;
      color: white;

      border: 1px solid #303030;
      border-radius: 20px;

      padding: 0 18px;

      font-size: 15px;
      outline: none;
    }

    .header-search input::placeholder {
      color: #aaaaaa;
    }

    .header-search input:focus {
      border-color: #555555;
    }


    /* =====================================
       RIGHT SIDE - AGENT NAME
    ===================================== */

    .agent-area {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;

      white-space: nowrap;
    }

    .agent-label {
      font-size: 13px;
      color: #aaaaaa;
    }

    .agent-input {
      width: 130px;
      height: 36px;

      background: #121212;
      color: white;

      border: 1px solid #303030;
      border-radius: 18px;

      padding: 0 14px;

      font-size: 14px;
      outline: none;
    }

    .agent-input::placeholder {
      color: #888888;
    }

    .agent-input:focus {
      border-color: #555555;
    }


    /* =====================================
       MAIN CONTENT
    ===================================== */

    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 30px 25px 60px;
    }


    /* =====================================
       CUSTOMER NAME
    ===================================== */

    .customer-section {
      background: white;
      padding: 18px 20px;

      border-radius: 12px;
      border: 1px solid #dadce0;

      margin-bottom: 25px;
    }

    .customer-label {
      display: block;

      font-size: 14px;
      font-weight: bold;

      margin-bottom: 7px;
    }

    .customer-input {
      width: 100%;

      padding: 12px 14px;

      font-size: 16px;

      border: 1px solid #dadce0;
      border-radius: 8px;

      outline: none;
    }

    .customer-input:focus {
      border-color: #1a73e8;
    }


    /* =====================================
       CATEGORY BUTTONS
    ===================================== */

    .categories {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;
    }

    .category-button {
      width: 100%;

      padding: 20px;

      font-size: 19px;
      font-weight: bold;

      border: none;
      border-radius: 12px;

      background: #1a73e8;
      color: white;

      cursor: pointer;

      transition: 0.15s;
    }

    .category-button:hover {
      background: #1557b0;

      transform:
        translateY(-1px);
    }


    /* =====================================
       RESPONSE AREA
    ===================================== */

    .response-area {
      margin-top: 30px;
    }

    .response-header {
      display: flex;

      justify-content:
        space-between;

      align-items: center;

      margin-bottom: 18px;
    }

    .response-title {
      font-size: 22px;
      font-weight: bold;
    }

    .back-button {
      border: none;

      background: transparent;

      color: #1a73e8;

      font-size: 15px;

      cursor: pointer;

      font-weight: bold;
    }


    /* =====================================
       RESPONSE CARDS
    ===================================== */

    .response-card {
      background: white;

      border: 1px solid #dadce0;

      border-radius: 12px;

      padding: 20px;

      margin-bottom: 18px;

      cursor: pointer;

      transition: 0.15s;
    }

    .response-card:hover {
      border-color: #1a73e8;

      box-shadow:
        0 3px 10px
        rgba(0, 0, 0, 0.08);
    }

    .situation {
      font-size: 18px;

      font-weight: bold;

      margin-bottom: 8px;
    }

    .description {
      font-size: 14px;

      color: #5f6368;

      margin-bottom: 15px;
    }

    .response {
      padding: 15px;

      background: #f8f9fa;

      border-radius: 8px;

      line-height: 1.55;

      font-size: 15px;

      white-space: pre-wrap;
    }

    .copy-hint {
      margin-top: 12px;

      font-size: 13px;

      color: #5f6368;

      text-align: right;
    }


    /* =====================================
       SEARCH RESULTS
    ===================================== */

    .search-heading {
      font-size: 20px;

      font-weight: bold;

      margin-bottom: 18px;
    }

    .search-category {
      font-size: 12px;

      color: #1a73e8;

      font-weight: bold;

      margin-bottom: 7px;

      text-transform: uppercase;
    }

    .no-results {
      background: white;

      border: 1px solid #dadce0;

      border-radius: 10px;

      padding: 20px;

      text-align: center;

      color: #5f6368;
    }


    /* =====================================
       COPY MESSAGE
    ===================================== */

    .message {
      position: fixed;

      bottom: 25px;

      left: 50%;

      transform:
        translateX(-50%);

      background: #202124;

      color: white;

      padding: 14px 22px;

      border-radius: 8px;

      display: none;

      font-size: 15px;

      z-index: 1000;
    }


    /* =====================================
       FOOTER
    ===================================== */

    .footer {
      margin-top: 50px;

      padding: 15px 0;

      text-align: center;

      font-size: 11px;

      color: #9aa0a6;

      letter-spacing: 0.2px;
    }


    /* =====================================
       MOBILE
    ===================================== */

    @media (max-width: 750px) {

      .header-inner {
        grid-template-columns: 1fr;

        height: auto;

        padding: 15px 20px;

        gap: 12px;
      }

      .brand {
        justify-content: center;
      }

      .header-search {
        max-width: 100%;
      }

      .agent-area {
        justify-content: center;
      }

      .categories {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>


<body>


  <!-- =====================================
       HEADER
  ===================================== -->

  <header class="header">

    <div class="header-inner">


      <!-- LEFT -->

      <div class="brand">

        <div class="youtube-icon"></div>

        <div class="brand-title">
          Canned Response Tool
        </div>

      </div>


      <!-- CENTER -->

      <div class="header-search">

        <input
          id="searchInput"
          type="text"
          placeholder="Search canned responses..."
          oninput="performSearch()"
        >

      </div>


      <!-- RIGHT -->

      <div class="agent-area">

        <span class="agent-label">
          Agent:
        </span>

        <input
          id="agentName"
          class="agent-input"
          type="text"
          placeholder="Your name"
        >

      </div>


    </div>

  </header>



  <!-- =====================================
       MAIN
  ===================================== -->

  <div class="container">


    <!-- CUSTOMER NAME -->

    <div class="customer-section">

      <label class="customer-label">
        Customer Name
      </label>

      <input
        id="customerName"
        class="customer-input"
        type="text"
        placeholder="Enter customer name"
      >

    </div>



    <!-- CATEGORY BUTTONS -->

    <div
      id="categories"
      class="categories"
    >

      Loading categories...

    </div>



    <!-- RESPONSE AREA -->

    <div
      id="responseArea"
      class="response-area"
      style="display: none;"
    >

      <div class="response-header">

        <div
          id="responseTitle"
          class="response-title"
        >
        </div>


        <button
          class="back-button"
          onclick="showCategories()"
        >
          ← Back
        </button>

      </div>


      <div id="responses"></div>

    </div>



    <!-- SEARCH RESULTS -->

    <div
      id="searchResults"
      class="response-area"
      style="display: none;"
    >

      <div class="search-heading">
        Search Results
      </div>

      <div id="searchResultsContainer"></div>

    </div>



    <!-- FOOTER -->

    <footer class="footer">

      Internal Support Utility ·
      Build 1.0.0 ·
      2026 ·
      Developed by Mohit S.

    </footer>


  </div>



  <!-- COPY MESSAGE -->

  <div
    id="message"
    class="message"
  >
    ✓ Response copied to clipboard
  </div>



  <script>

    let allResponses = [];


    /* =====================================
       LOAD DATA
    ===================================== */

    google.script.run

      .withSuccessHandler(function(data) {

        allResponses = data;

        buildCategoryButtons();

      })

      .withFailureHandler(function(error) {

        console.error(error);

        document.getElementById(
          "categories"
        ).innerHTML =
          "<p>Could not load responses.</p>";

        alert(
          "ERROR: " +
          error.message
        );

      })

      .getResponses();



    /* =====================================
       BUILD CATEGORY BUTTONS
    ===================================== */

    function buildCategoryButtons() {

      const container =
        document.getElementById(
          "categories"
        );

      container.innerHTML = "";


      const categories = [
        ...new Set(

          allResponses.map(
            function(item) {

              return item.category;

            }
          )

        )
      ];


      categories.forEach(
        function(category) {

          const button =
            document.createElement(
              "button"
            );

          button.className =
            "category-button";

          button.textContent =
            category.toUpperCase();


          button.addEventListener(
            "click",
            function() {

              showCategory(
                category
              );

            }
          );


          container.appendChild(
            button
          );

        }
      );

    }



    /* =====================================
       SHOW CATEGORY
    ===================================== */

    function showCategory(category) {

      document
        .getElementById("categories")
        .style.display = "none";


      document
        .getElementById("searchResults")
        .style.display = "none";


      document
        .getElementById("responseArea")
        .style.display = "block";


      document
        .getElementById("responseTitle")
        .textContent =
          category.toUpperCase();


      const responsesContainer =
        document.getElementById(
          "responses"
        );

      responsesContainer.innerHTML =
        "";


      const categoryResponses =
        allResponses.filter(
          function(item) {

            return item.category ===
              category;

          }
        );


      categoryResponses.forEach(
        function(item) {

          createResponseCard(
            item,
            responsesContainer,
            true
          );

        }
      );

    }



    /* =====================================
       CREATE RESPONSE CARD
    ===================================== */

    function createResponseCard(
      item,
      container,
      showCategoryName
    ) {

      const card =
        document.createElement(
          "div"
        );

      card.className =
        "response-card";


      if (!showCategoryName) {

        const category =
          document.createElement(
            "div"
          );

        category.className =
          "search-category";

        category.textContent =
          item.category;

        card.appendChild(
          category
        );

      }


      const situation =
        document.createElement(
          "div"
        );

      situation.className =
        "situation";

      situation.textContent =
        item.situation;


      const description =
        document.createElement(
          "div"
        );

      description.className =
        "description";

      description.textContent =
        item.description;


      const response =
        document.createElement(
          "div"
        );

      response.className =
        "response";


      const personalizedResponse =
        personalizeResponse(
          item.response
        );


      response.textContent =
        personalizedResponse;


      const copyHint =
        document.createElement(
          "div"
        );

      copyHint.className =
        "copy-hint";

      copyHint.textContent =
        "Click anywhere to copy";


      card.appendChild(
        situation
      );

      card.appendChild(
        description
      );

      card.appendChild(
        response
      );

      card.appendChild(
        copyHint
      );


      card.addEventListener(
        "click",
        function() {

          copyResponse(
            personalizedResponse
          );

        }
      );


      container.appendChild(
        card
      );

    }



    /* =====================================
       PERSONALIZE RESPONSE
    ===================================== */

    function personalizeResponse(
      response
    ) {

      const customerName =
        document
          .getElementById(
            "customerName"
          )
          .value
          .trim();


      const agentName =
        document
          .getElementById(
            "agentName"
          )
          .value
          .trim();


      return response

        .replace(
          /{{CUSTOMER_NAME}}/g,
          customerName ||
          "there"
        )

        .replace(
          /{{REPRESENTATIVE_NAME}}/g,
          agentName ||
          "your representative"
        );

    }



    /* =====================================
       SEARCH
    ===================================== */

    function performSearch() {

      const searchInput =
        document
          .getElementById(
            "searchInput"
          )
          .value
          .trim()
          .toLowerCase();


      const categories =
        document.getElementById(
          "categories"
        );


      const responseArea =
        document.getElementById(
          "responseArea"
        );


      const searchResults =
        document.getElementById(
          "searchResults"
        );


      const resultsContainer =
        document.getElementById(
          "searchResultsContainer"
        );


      if (!searchInput) {

        searchResults.style.display =
          "none";

        responseArea.style.display =
          "none";

        categories.style.display =
          "grid";

        return;

      }


      categories.style.display =
        "none";

      responseArea.style.display =
        "none";

      searchResults.style.display =
        "block";


      resultsContainer.innerHTML =
        "";


      const results =
        allResponses.filter(
          function(item) {

            const searchableText = [

              item.category,

              item.situation,

              item.description,

              item.response

            ]

              .join(" ")

              .toLowerCase();


            return searchableText.includes(
              searchInput
            );

          }
        );


      if (results.length === 0) {

        resultsContainer.innerHTML = `
          <div class="no-results">
            No matching responses found.
          </div>
        `;

        return;

      }


      results.forEach(
        function(item) {

          createResponseCard(
            item,
            resultsContainer,
            false
          );

        }
      );

    }



    /* =====================================
       COPY RESPONSE
    ===================================== */

    function copyResponse(
      response
    ) {

      navigator.clipboard
        .writeText(response)

        .then(
          function() {

            showMessage();

          }
        )

        .catch(
          function(error) {

            console.error(error);

            alert(
              "Could not copy response to clipboard."
            );

          }
        );

    }



    /* =====================================
       COPY MESSAGE
    ===================================== */

    function showMessage() {

      const message =
        document.getElementById(
          "message"
        );


      message.style.display =
        "block";


      setTimeout(
        function() {

          message.style.display =
            "none";

        },
        1500
      );

    }



    /* =====================================
       BACK TO CATEGORIES
    ===================================== */

    function showCategories() {

      document
        .getElementById(
          "responseArea"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "searchResults"
        )
        .style.display =
          "none";


      document
        .getElementById(
          "categories"
        )
        .style.display =
          "grid";


      document
        .getElementById(
          "searchInput"
        )
        .value =
          "";

    }

  </script>

</body>

</html>
